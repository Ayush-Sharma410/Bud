{
  "name": "bud",
  "version": "0.1.0",
  "description": "Bud — Windows desktop voice companion",
  "main": "dist/main/main.js",
  "scripts": {
    "canvas:build": "vite build --config vite.canvas.config.ts",
    "build": "tsc && npm run canvas:build",
    "start": "npm run build && electron .",
    "dev": "tsc && npm run canvas:build && electron .",
    "package": "npm run build && electron-builder"
  },
  "author": "Ayush",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "vite": "^8.1.0"
  },
  "dependencies": {
    "@ai-sdk/groq": "^3.0.42",
    "@ai-sdk/openai": "^3.0.69",
    "@ai-sdk/openai-compatible": "^2.0.51",
    "@excalidraw/excalidraw": "^0.18.1",
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@nut-tree-fork/nut-js": "^4.2.6",
    "@types/ws": "^8.18.1",
    "ai": "^6.0.199",
    "assemblyai": "^4.34.4",
    "better-sqlite3": "^12.10.0",
    "mammoth": "^1.12.0",
    "ollama-ai-provider-v2": "^3.6.0",
    "openai": "^6.42.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "screenshot-desktop": "^1.15.0",
    "sharp": "^0.35.2",
    "uiohook-napi": "^1.5.4",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "com.bud.desktop",
    "productName": "Bud",
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "directories": {
      "output": "release"
    }
  }
}
