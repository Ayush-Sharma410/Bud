{
  "name": "bud",
  "version": "0.1.0",
  "description": "Bud — AI-native Excalidraw voice copilot (cross-platform)",
  "main": "dist/main/main.js",
  "scripts": {
    "canvas:build": "vite build --config vite.canvas.config.ts",
    "build": "tsc && npm run canvas:build",
    "typecheck": "tsc --noEmit",
    "start": "npm run build && electron .",
    "dev": "tsc && npm run canvas:build && electron .",
    "package": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "author": "Ayush",
  "license": "MIT",
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0",
    "vite": "^8.1.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.69",
    "@ai-sdk/openai-compatible": "^2.0.51",
    "@excalidraw/excalidraw": "^0.18.1",
    "@types/ws": "^8.18.1",
    "ai": "^6.0.199",
    "better-sqlite3": "^12.10.0",
    "openai": "^6.42.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "com.bud.desktop",
    "productName": "Bud",
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    },
    "directories": {
      "output": "release"
    }
  }
}
