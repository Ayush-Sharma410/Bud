# ═══════════════════════════════════════════════════════════════
#  Bud — Environment Variables
#  Copy this file to .env and fill in the values.
# ═══════════════════════════════════════════════════════════════

# ── Core (Required) ──────────────────────────────────────────
# OpenAI — powers the Realtime voice pipeline, chat, TTS, and vision.
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Optional: override default models
# OPENAI_MODEL=gpt-5.1
# OPENAI_REALTIME_MODEL=gpt-realtime-2
# OPENAI_REALTIME_VOICE=cedar

# ── Cartesia Realtime (Experimental) ─────────────────────────
# Set REALTIME_PROVIDER=cartesia to use Cartesia for STT/TTS instead of OpenAI WebRTC.
# Get key: https://cartesia.ai/
# REALTIME_PROVIDER=cartesia
# CARTESIA_API_KEY=
# CARTESIA_TTS_MODEL=sonic-3.5
# CARTESIA_TTS_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091
# CARTESIA_STT_MODEL=ink-2
# CARTESIA_STT_SAMPLE_RATE=24000

# ── Web Search ───────────────────────────────────────────────
# Exa — AI-native web search used by the searchWeb tool.
# Get key: https://dashboard.exa.ai/api-keys
EXA_API_KEY=

# ── Spotify (OAuth) ──────────────────────────────────────────
# Create an app at https://developer.spotify.com/dashboard
# Set redirect URI to: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# ── GitHub ───────────────────────────────────────────────────
# Personal Access Token (classic or fine-grained).
# Create at: https://github.com/settings/tokens
# Scopes: repo, read:org, notifications
GITHUB_TOKEN=github_pat_...

# ── Google (Gmail + Calendar + Drive) ────────────────────────
# All three Google services share one OAuth flow via GoogleAuthProvider.
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an OAuth 2.0 Client ID (Desktop app)
# 3. Set redirect URI to: http://127.0.0.1:8889/callback
# 4. Enable Gmail API, Google Calendar API, and Google Drive API in your project
# On first use, Bud will open the browser for you to authorize.
# Tokens are stored in google_tokens.json and auto-refreshed.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Slack ────────────────────────────────────────────────────
# Bot User OAuth Token from a Slack App.
# Create app: https://api.slack.com/apps
# Required scopes: chat:write, channels:read, conversations:history
SLACK_BOT_TOKEN=xoxb-...

# ── Discord ──────────────────────────────────────────────────
# Bot token from the Discord Developer Portal.
# Create app: https://discord.com/developers/applications
# Enable "Bot" → copy token. Required intents: Message Content, Server Members
DISCORD_BOT_TOKEN=

# ── Notion ───────────────────────────────────────────────────
# Integration token from Notion's developer portal.
# Create at: https://www.notion.so/my-integrations
# Then share the target database/page with the integration.
NOTION_API_KEY=ntn_...

# ── Supabase ─────────────────────────────────────────────────
# Project URL and API keys from your Supabase dashboard.
# Get from: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# ── Vercel ───────────────────────────────────────────────────
# Personal access token from Vercel dashboard.
# Create at: https://vercel.com/account/tokens
VERCEL_TOKEN=

# ── YouTube (YouTube Data API v3) ────────────────────────────
# Enable YouTube Data API v3 in Google Cloud Console.
# Create an API key: https://console.cloud.google.com/apis/credentials
# Quota: 10,000 units/day free.
YOUTUBE_API_KEY=

# ── Todoist ──────────────────────────────────────────────────
# API token from Todoist settings.
# Get at: https://app.todoist.com/app/settings/integrations/developer
TODOIST_API_TOKEN=

# ── Linear ───────────────────────────────────────────────────
# Personal API key from Linear settings.
# Get at: https://linear.app/settings/api
LINEAR_API_KEY=lin_api_...

# ── OpenWeatherMap ───────────────────────────────────────────
# Free tier: 1,000 calls/day.
# Get key: https://openweathermap.org/api → Sign up → My API Keys
OPENWEATHER_API_KEY=

# ── Philips Hue (Smart Home) ─────────────────────────────────
# 1. Find your bridge IP: https://discovery.meethue.com
# 2. Create a user by pressing the link button on the bridge, then POST:
#    curl -X POST http://<BRIDGE_IP>/api -d '{"devicetype":"bud"}'
# 3. Copy the "username" from the response.
HUE_BRIDGE_IP=
HUE_USERNAME=

# ── ElevenLabs (Legacy TTS) ──────────────────────────────────
# Only needed if using the legacy Modal TTS provider.
# Get key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=
# ELEVENLABS_MODEL_ID=

# ── AssemblyAI (Legacy STT) ──────────────────────────────────
# Only needed if using the AssemblyAI STT provider.
# Get key: https://www.assemblyai.com/app/account
ASSEMBLYAI_API_KEY=
