# Bud — Environment Variables
# Copy this file to .env and fill in the values.

# Core LLM (Required)
# OpenAI — powers the Orchestrator (reasoning + tool calls) and chat.
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# Optional: override the default model (gpt-5.1).
# OPENAI_MODEL=gpt-5.1

# Optional: point to any OpenAI-compatible endpoint instead of OpenAI.
# When set, Bud routes all requests through this base URL (e.g. a local
# sglang/vLLM server, OpenRouter, Azure OpenAI, etc.).
# OPENAI_BASE_URL=https://your-endpoint.example.com

# Two-model orchestrator split (optional)
# BUD_PREAMBLE_MODEL=gpt-4.1-mini   # fast triage / engagement ack
# BUD_ORCHESTRATOR_MODEL=gpt-5.1    # tool calls + reasoning

# Cartesia Voice (Required for voice)
# Streaming STT + TTS over WebSockets. Get key: https://cartesia.ai/
CARTESIA_API_KEY=
# CARTESIA_TTS_MODEL=sonic-3.5
# CARTESIA_TTS_VOICE_ID=a0e99841-438c-4a64-b679-ae501e7d6091
# CARTESIA_STT_MODEL=ink-2
# CARTESIA_STT_SAMPLE_RATE=24000

# Exa — AI-native web search used by the searchWeb tool (Optional)
# Get key: https://dashboard.exa.ai/api-keys
EXA_API_KEY=
